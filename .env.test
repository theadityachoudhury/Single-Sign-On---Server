# Test Environment Configuration
NODE_ENV=test
TZ=Asia/Kolkata
PORT=4001

# JWT Configuration (test values)
JWT_SECRET=test-jwt-secret-key-for-testing-purposes-only-do-not-use-in-production
JWT_EXPIRE=1d
REFRESH_TOKEN_SECRET=test-refresh-token-secret-for-testing-only
REFRESH_TOKEN_EXPIRE=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_URL=http://localhost

# Database (will be overridden by MongoDB Memory Server in tests)
AUTH_DB_MONGO_URI=mongodb://localhost:27017/auth-test
OAUTH_DB_MONGO_URI=mongodb://localhost:27017/oauth-test
IDENTITY_DB_MONGO_URI=mongodb://localhost:27017/identity-test

# Mail Configuration (optional for tests)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=testpassword
MAIL_FROM=noreply@example.com

# Cloud Configuration (optional for tests)
CLOUD_PROVIDER=local
CLOUD_BUCKET=test-bucket
CLOUD_REGION=us-east-1

# Logging
LOG_LEVEL=error

# API Configuration
API_PREFIX=api
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=1000
