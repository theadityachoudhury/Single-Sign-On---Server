# ===============================
# Environment
# ===============================
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata

# ===============================
# JWT
# ===============================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=1d
REFRESH_TOKEN_SECRET=your_refresh_secret_here
REFRESH_TOKEN_EXPIRE=7d

# ===============================
# CORS
# ===============================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://myapp.com

# ===============================
# MongoDB (Three separate DBs)
# ===============================
AUTH_DB_MONGO_URI=mongodb://localhost:27017/auth_db
OAUTH_DB_MONGO_URI=mongodb://localhost:27017/user_db
IDENTITY_DB_MONGO_URI=mongodb://localhost:27017/analytics_db

# ===============================
# Redis
# ===============================
REDIS_URL=redis://localhost:6379

# ===============================
# Mail / SMTP (Optional)
# ===============================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=no-reply@example.com

# ===============================
# Logging
# ===============================
LOG_LEVEL=info

# ===============================
# API & Misc
# ===============================
API_PREFIX=/api
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
