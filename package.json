{
    "name": "single-sign-on---server",
    "version": "1.0.0",
    "description": "",
    "main": "dist/server.js",
    "type": "module",
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "npm run format",
            "npm run lint -- --fix"
        ]
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/server.js",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write .",
        "clean": "rimraf dist",
        "prepare": "husky",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
        "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
        "test:functional": "NODE_OPTIONS=--experimental-vm-modules jest tests/functional",
        "test:system": "NODE_OPTIONS=--experimental-vm-modules jest tests/system",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "test:coverage:report": "NODE_OPTIONS=--experimental-vm-modules jest --coverage && open coverage/lcov-report/index.html",
        "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --maxWorkers=2"
    },
    "author": "Aditya Choudhury",
    "license": "ISC",
    "devDependencies": {
        "@jest/globals": "^30.2.0",
        "@types/bcrypt": "^6.0.0",
        "@types/consola": "^1.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/helmet": "^0.0.48",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.7.2",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^17.23.1",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-security": "^3.0.1",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.4",
        "mongodb-memory-server": "^10.2.3",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.5",
        "ts-jest-resolver": "^2.0.1",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "argon2": "^0.44.0",
        "axios": "^1.12.2",
        "bcrypt": "^6.0.0",
        "consola": "^3.4.2",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.19.1",
        "uuid": "^13.0.0",
        "winston": "^3.18.3",
        "zod": "^4.1.12"
    }
}
